{
  "version": "1.1.0",
  "session_defaults": {
    "plaisir": {
      "intensity": "easy",
      "intensity_modifier": 0.85,
      "check_in_freq_min": 60,
      "skip_alert_threshold": 2,
      "deficit_alert_pct": 0.30
    },
    "long": {
      "intensity": "moderate",
      "intensity_modifier": 1.0,
      "check_in_freq_min": 50,
      "skip_alert_threshold": 2,
      "deficit_alert_pct": 0.30
    },
    "dur": {
      "intensity": "hard",
      "intensity_modifier": 1.15,
      "check_in_freq_min": 45,
      "skip_alert_threshold": 2,
      "deficit_alert_pct": 0.30
    },
    "test": {
      "intensity": "moderate",
      "intensity_modifier": 1.0,
      "check_in_freq_min": 40,
      "skip_alert_threshold": 2,
      "deficit_alert_pct": 0.30
    },
    "competition": {
      "intensity": "hard",
      "intensity_modifier": 1.20,
      "check_in_freq_min": 45,
      "skip_alert_threshold": 1,
      "deficit_alert_pct": 0.20
    }
  },
  "param_defaults": {
    "first_intake_after_min": 30,
    "intake_interval_min": 20,
    "first_fluid_reminder_min": 15,
    "fluid_reminder_interval_min": 30
  },
  "param_clamps": {
    "first_intake_after_min": { "min": 0, "max": 240 },
    "intake_interval_min": { "min": 1, "max": 60 },
    "check_in_frequency_min": { "min": 1, "max": 120 },
    "first_fluid_reminder_min": { "min": 0, "max": 240 },
    "fluid_reminder_interval_min": { "min": 1, "max": 120 }
  },
  "rate_bounds": {
    "fluid_floor_ml": 300,
    "fluid_ceiling_ml": 800,
    "sodium_floor_mg": 300,
    "sodium_ceiling_mg": 1000
  },
  "fluid_modifiers": {
    "temperature": {
      "hot_threshold_c": 20,
      "hot_increment_per_c": 50,
      "cold_threshold_c": 10,
      "cold_increment_per_c": 50
    },
    "humidity_high_factor": 1.15
  },
  "sodium_modifiers": {
    "long_duration_threshold_min": 180,
    "long_duration_add_mg": 100,
    "hot_temperature_threshold_c": 25,
    "hot_temperature_add_mg": 200,
    "humidity_high_add_mg": 100
  },
  "exposure_modifiers": {
    "sun": 1.10,
    "shade": 0.95,
    "variable": 1.0
  },
  "first_hour": {
    "reduction_factor": 0.70,
    "duration_min": 60
  },
  "aid_station_estimates": {
    "carbs_per_solid_stop_g": 30,
    "carbs_per_isotonic_stop_g": 30,
    "fluid_per_water_stop_ml": 500,
    "fluid_per_isotonic_stop_ml": 500
  },
  "feasibility_threshold": 0.85,
  "rules": [
    {
      "id": "intensity-carbs-plaisir",
      "source": "base",
      "category": "nutrition",
      "scope": "race",
      "description": "Session plaisir : carbs × 0.85",
      "condition": { "field": "session_type", "op": "equals", "value": "plaisir" },
      "action": { "target": "carbs_per_hour_g", "op": "multiply", "value": 0.85 }
    },
    {
      "id": "intensity-carbs-dur",
      "source": "base",
      "category": "nutrition",
      "scope": "race",
      "description": "Session dur : carbs × 1.15",
      "condition": { "field": "session_type", "op": "equals", "value": "dur" },
      "action": { "target": "carbs_per_hour_g", "op": "multiply", "value": 1.15 }
    },
    {
      "id": "intensity-carbs-competition",
      "source": "base",
      "category": "nutrition",
      "scope": "race",
      "description": "Session competition : carbs × 1.20",
      "condition": { "field": "session_type", "op": "equals", "value": "competition" },
      "action": { "target": "carbs_per_hour_g", "op": "multiply", "value": 1.20 }
    },
    {
      "id": "fluid-temp-hot",
      "source": "base",
      "category": "nutrition",
      "scope": "race",
      "description": "Température > 20°C : +50 ml/h par °C au-dessus",
      "condition": { "field": "temperature_c", "op": "gt", "value": 20 },
      "action": {
        "target": "fluid_per_hour_ml",
        "op": "add",
        "value": { "expr": "(temperature_c - 20) * 50" }
      }
    },
    {
      "id": "fluid-temp-cold",
      "source": "base",
      "category": "nutrition",
      "scope": "race",
      "description": "Température < 10°C : compensation linéaire (-50 ml/h par °C en dessous)",
      "condition": { "field": "temperature_c", "op": "lt", "value": 10 },
      "action": {
        "target": "fluid_per_hour_ml",
        "op": "add",
        "value": { "expr": "(temperature_c - 10) * 50" }
      }
    },
    {
      "id": "fluid-humidity-high",
      "source": "base",
      "category": "nutrition",
      "scope": "race",
      "description": "Humidité haute : fluid × 1.15",
      "condition": { "field": "humidity_high", "op": "equals", "value": true },
      "action": { "target": "fluid_per_hour_ml", "op": "multiply", "value": 1.15 }
    },
    {
      "id": "fluid-exposure-sun",
      "source": "base",
      "category": "nutrition",
      "scope": "race",
      "description": "Exposition soleil : fluid × 1.10",
      "condition": { "field": "exposure", "op": "equals", "value": "sun" },
      "action": { "target": "fluid_per_hour_ml", "op": "multiply", "value": 1.10 }
    },
    {
      "id": "fluid-exposure-shade",
      "source": "base",
      "category": "nutrition",
      "scope": "race",
      "description": "Exposition ombre : fluid × 0.95",
      "condition": { "field": "exposure", "op": "equals", "value": "shade" },
      "action": { "target": "fluid_per_hour_ml", "op": "multiply", "value": 0.95 }
    },
    {
      "id": "sodium-long-duration",
      "source": "base",
      "category": "nutrition",
      "scope": "race",
      "description": "Durée > 180 min : +100 mg/h sodium",
      "condition": { "field": "duration_min", "op": "gt", "value": 180 },
      "action": { "target": "sodium_per_hour_mg", "op": "add", "value": 100 }
    },
    {
      "id": "sodium-hot-temp",
      "source": "base",
      "category": "nutrition",
      "scope": "race",
      "description": "Température > 25°C : +200 mg/h sodium",
      "condition": { "field": "temperature_c", "op": "gt", "value": 25 },
      "action": { "target": "sodium_per_hour_mg", "op": "add", "value": 200 }
    },
    {
      "id": "sodium-humidity-high",
      "source": "base",
      "category": "nutrition",
      "scope": "race",
      "description": "Humidité haute : +100 mg/h sodium",
      "condition": { "field": "humidity_high", "op": "equals", "value": true },
      "action": { "target": "sodium_per_hour_mg", "op": "add", "value": 100 }
    },
    {
      "id": "slope-descent-technical-no-intake",
      "source": "base",
      "category": "placement",
      "scope": "window",
      "description": "Descente technique : pas d'intake placé",
      "condition": {
        "field": "window.slope_category",
        "op": "equals",
        "value": "descent_technical"
      },
      "action": { "op": "set_allowed_kinds", "kinds": null }
    },
    {
      "id": "slope-climb-steep-gel-only",
      "source": "base",
      "category": "placement",
      "scope": "window",
      "description": "Montée raide : uniquement des gels (digestes en effort élevé)",
      "condition": {
        "field": "window.slope_category",
        "op": "equals",
        "value": "climb_steep"
      },
      "action": { "op": "set_allowed_kinds", "kinds": ["gel"] }
    }
  ]
}
